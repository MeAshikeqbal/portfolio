# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

.sanity

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

public/Thumbs.db

# test artifacts
/playwright-report/
/test-results/
/blob-report/

# sanity typegen intermediate
/schema.json

# lighthouse ci
/.lighthouseci/
/lighthouse-report/

# Sanity dataset exports (npm run backup); the inbox export holds personal data
/backups/

# scripts/about-content.ts dry-run snapshot (revisions + content hash)
/scripts/.about-content.snapshot.json
/scripts/.curation.snapshot.json

# python
__pycache__/
