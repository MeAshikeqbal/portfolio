# Copy to .env.local and fill in. Only NEXT_PUBLIC_* values are sent to the browser.

# --- Sanity (required) -------------------------------------------------------
# Public project id and dataset (they appear in every image URL).
NEXT_PUBLIC_SANITY_PROJECT_ID=0oqq6f9z
NEXT_PUBLIC_SANITY_DATASET=production
# Optional: pin the Content Lake API version (defaults to the one in sanity/env.ts).
# NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01

# Write token (Editor) used by the contact form and the GitHub sync. Server only.
SANITY_API_TOKEN=

# Viewer token for draft previews (Studio → Presentation). Optional: without it the site
# serves published content only and draft mode stays off. Server only.
SANITY_API_READ_TOKEN=

# Shared secret for the Sanity webhook (Authorization: Bearer <secret>) that revalidates
# pages on publish. Configure the webhook at sanity.io/manage → API → Webhooks.
SANITY_WEBHOOK_SECRET=

# --- GitHub project sync (/api/sync-github-data, daily via Vercel Cron) ------
# Fine-grained token with read-only access to your public repositories.
GITHUB_ACCESS_TOKEN=
# Vercel sends `Authorization: Bearer $CRON_SECRET` to cron routes.
CRON_SECRET=

# --- Contact form anti-spam (Cloudflare Turnstile) ---------------------------
# Test keys that always pass: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
