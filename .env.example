# Copy to .env.local and fill in. Only NEXT_PUBLIC_* values are sent to the browser.

# --- Sanity (required) -------------------------------------------------------
# Public project id and dataset (they appear in every image URL).
NEXT_PUBLIC_SANITY_PROJECT_ID=0oqq6f9z
NEXT_PUBLIC_SANITY_DATASET=production
# Optional: pin the Content Lake API version (defaults to the one in sanity/env.ts).
# NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01

# Write token (Editor) used by the contact form and the GitHub sync. Server only.
SANITY_API_TOKEN=

# Viewer token for draft previews (Studio → Presentation). Optional: without it the site
# serves published content only and draft mode stays off. Server only.
SANITY_API_READ_TOKEN=

# Shared secret for the Sanity webhook (Authorization: Bearer <secret>) that revalidates
# pages on publish. Configure the webhook at sanity.io/manage → API → Webhooks.
SANITY_WEBHOOK_SECRET=

# --- GitHub project sync (/api/sync-github-data, daily via Vercel Cron) ------
# Fine-grained token with read-only access to your public repositories.
GITHUB_ACCESS_TOKEN=
# Vercel sends `Authorization: Bearer $CRON_SECRET` to cron routes.
CRON_SECRET=

# --- Contact messages ----------------------------------------------------------
# Messages are stored in a PRIVATE dataset (never the public one). Defaults to "inbox".
# SANITY_INBOX_DATASET=inbox
# NEXT_PUBLIC_SANITY_INBOX_DATASET=inbox   # same value, for the Studio's Inbox workspace


# --- Contact form anti-spam (Cloudflare Turnstile) ---------------------------
# Test keys that always pass: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# --- Live activity on /now and the hero (/api/now-playing) --------------------
# Each integration stays hidden until its variables are set. All server only.
# Spotify: create an app at developer.spotify.com with the redirect URI
# http://127.0.0.1:8888/callback, then run `node scripts/spotify-auth.mjs` once to get the
# refresh token.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Trakt: an API app's client ID and your username. The profile must be public.
TRAKT_CLIENT_ID=
TRAKT_USERNAME=
# Jellyfin: the public server URL and an API key (Dashboard → API Keys). Only stream counts
# are published. API keys have admin rights: keep this one in Vercel env only.
JELLYFIN_URL=
JELLYFIN_API_KEY=

# --- Homelab heartbeat (/api/lab-heartbeat, /api/lab-status) -----------------
# Each Proxmox node's agent POSTs a signed, anonymized report every 30s
# (scripts/lab-heartbeat/README.md). It feeds /homecave, the hero's homelab list and the
# system bar. Hidden until a heartbeat has arrived. Server only.
# Shared HMAC secret, same value as LAB_HEARTBEAT_SECRET on the lab (openssl rand -hex 32).
LAB_HEARTBEAT_SECRET=
# Upstash Redis REST credentials (or the Vercel integration's KV_REST_API_URL / KV_REST_API_TOKEN).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
